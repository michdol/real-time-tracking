# Edge accepts one DCSA event per POST. Carrier and scenario id are headers.
INGEST_URL=http://localhost:8000/event
# Voyages to generate. Each voyage sends 8 events, in order.
SCENARIOS=100
# Voyages posted at the same time. Events inside one voyage stay in order.
CONCURRENCY=10
# Events per second across all workers. 0 sends as fast as the app accepts them.
RATE_LIMIT=0
# Shared secret. Edge must use this same value to verify X-Signature.
SIGNING_SECRET=dev-signing-secret
# Send the header value "invalid signature" on every Nth event. 0 sends only valid ones.
INVALID_SIGNATURE_EVERY=0
